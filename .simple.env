# ============================================
# نمونه تنظیمات محیطی
# این فایل را به .env کپی کنید و مقادیر را پر کنید:
#   copy .simple.env .env
# ============================================

# ============================================
# تنظیمات جنگو
# ============================================
SECRET_KEY=your_very_very_secret_django_secret_key_change_this
ALLOWED_HOSTS=["localhost", "127.0.0.1"]

# ============================================
# دیتابیس
# پیش‌فرض محیط توسعه: SQLite (بدون نیاز به نصب سرور دیتابیس)
# برای MySQL:
#   DB_ENGINE=django.db.backends.mysql
#   DB_NAME=shahan_shop
#   DB_USER=root
#   DB_PASSWORD=your_super_secret_database_password
#   DB_HOST=127.0.0.1
#   DB_PORT=3306
# برای PostgreSQL (نیازمند نصب psycopg):
#   DB_ENGINE=django.db.backends.postgresql
#   DB_NAME=shahan_shop
#   DB_USER=postgres
#   DB_PASSWORD=your_super_secret_database_password
#   DB_HOST=localhost
#   DB_PORT=5432
# ============================================
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# ============================================
# زرین‌پال
# ============================================
ZARINPAL_MERCHANT_ID=your_zarinpal_merchant_id
ZARINPAL_SANDBOX=True